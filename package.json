{
  "name": "serambi",
  "productName": "Serambi",
  "version": "1.2.1",
  "description": "Kelola media sosial dan toko online, tumbuh di pencarian lokal, ulasan, iklan, kerja tim, dan pelindungan data pelanggan, dari satu aplikasi.",
  "main": "src/main/main.js",
  "author": {
    "name": "Yudhistira",
    "email": "yudhie7@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/gen-icons.js && node scripts/gen-assets.js",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "dist": "electron-builder --win --mac --publish never",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "id.serambi.app",
    "productName": "Serambi",
    "copyright": "Copyright © 2026 Yudhistira. Seluruh hak dilindungi.",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yudhis7",
        "repo": "serambi",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon-win.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Serambi-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Serambi",
      "installerLanguages": [
        "id_ID",
        "en_US"
      ],
      "language": "1057",
      "license": "build/license.txt",
      "uninstallDisplayName": "Serambi"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Serambi-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "Serambi memakai kamera untuk panggilan video di WhatsApp, Telegram, dan platform lain.",
        "NSMicrophoneUsageDescription": "Serambi memakai mikrofon untuk pesan suara dan panggilan."
      },
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "Serambi ${version}",
      "artifactName": "Serambi-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "lucide-static": "^1.59.0",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "homepage": "https://github.com/yudhis7/serambi",
  "repository": {
    "type": "git",
    "url": "https://github.com/yudhis7/serambi.git"
  }
}
